# ----------------------------------------------------------------------------
# Hardhat (deploy e scripts) — copie para .env
# ----------------------------------------------------------------------------
# Chave privada de uma carteira DEDICADA ao deploy. Nunca use sua carteira principal
# e nunca faça commit deste arquivo. Se uma chave vazar, mova os fundos imediatamente.
PRIVATE_KEY=

# RPCs (opcional; os padrões públicos funcionam)
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Chave da API Etherscan v2 para `hardhat verify` (vale para Polygon e Amoy)
POLYGONSCAN_API_KEY=

# Parâmetros do deploy (opcionais)
# Recompensa em wei por unidade de velocidade por segundo (1e14 = 0,0001 DAPPF)
FARM_REWARD_RATE=100000000000000
# DAPPF cunhados para o pool de recompensas do staking no deploy
STAKING_REWARD_POOL=0
# Endereço final dos contratos (ideal: um multisig Safe). Precisa chamar acceptOwnership().
OWNER_ADDRESS=

# Bot de saque automático (scripts/auto-withdraw.cjs)
TREASURY_ADDRESS=
WITHDRAW_INTERVAL_HOURS=2
WITHDRAW_MIN_BALANCE=1

# ----------------------------------------------------------------------------
# Frontend (Vite) — copie para .env.local
# Os valores VITE_* são públicos: ficam embutidos no bundle do navegador.
# ----------------------------------------------------------------------------
# 137 = Polygon, 80002 = Amoy (testnet), 31337 = Hardhat local
VITE_CHAIN_ID=137
# VITE_RPC_URL=https://polygon-rpc.com
# VITE_EXPLORER_URL=https://polygonscan.com

# Endereços impressos por `npm run deploy:*`
VITE_TOKEN_ADDRESS=
VITE_NFT_ADDRESS=
VITE_FARM_ADDRESS=
VITE_STAKING_ADDRESS=

# Firebase (opcional: sobrescreve a configuração padrão em src/services/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
