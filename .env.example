# ----------------------------------------------------------------------------
# Hardhat (deploy e scripts) — copie para .env
# ----------------------------------------------------------------------------
# Chave privada de uma carteira DEDICADA ao deploy. Nunca use sua carteira principal
# e nunca faça commit deste arquivo. Se uma chave vazar, mova os fundos imediatamente.
PRIVATE_KEY=

# RPCs (opcional; os padrões públicos funcionam)
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Chave da API Etherscan v2 para `hardhat verify` (vale para Polygon e Amoy)
POLYGONSCAN_API_KEY=

# Parâmetros do deploy (opcionais)
# Recompensa em wei por unidade de velocidade por segundo (1e14 = 0,0001 DAPPF)
FARM_REWARD_RATE=100000000000000
# DAPPF cunhados para o pool de recompensas do staking no deploy
STAKING_REWARD_POOL=0
# Dono final dos contratos (ideal: um multisig Safe). A transferência é em duas etapas: esse
# endereço precisa chamar acceptOwnership() em SpeedNFT, NFTFarm e TokenStaking e
# acceptDefaultAdminTransfer() em DAppToken. Até lá o deployer continua no controle.
OWNER_ADDRESS=

# Tesouraria fixa dos ovos: destino de withdrawToTreasury(), que qualquer um pode chamar.
# Use uma carteira fria ou multisig JÁ TESTADA. Default: o deployer (nunca o OWNER_ADDRESS ainda
# não aceito — um erro de digitação viraria um ralo irreversível das vendas).
TREASURY_ADDRESS=

# Bots (scripts/auto-withdraw.cjs e scripts/hatch-keeper.cjs) — usam PRIVATE_KEY só para pagar gás.
# Use uma carteira separada com pouco saldo; ela não precisa (nem deve) ser dona dos contratos.
# SPEED_NFT_ADDRESS=           # default: deployments/<rede>.json
WITHDRAW_INTERVAL_HOURS=2
WITHDRAW_MIN_BALANCE=1
KEEPER_INTERVAL_SECONDS=30
KEEPER_MIN_AGE_BLOCKS=5
# KEEPER_LOOKBACK_EGGS=2000

# REPORT_GAS=true              # relatório de gás no `npm test`

# ----------------------------------------------------------------------------
# Frontend (Vite) — copie para .env.local
# Os valores VITE_* são públicos: ficam embutidos no bundle do navegador.
# ----------------------------------------------------------------------------
# 137 = Polygon, 80002 = Amoy (testnet), 31337 = Hardhat local
VITE_CHAIN_ID=137
# VITE_RPC_URL=https://polygon-rpc.com
# VITE_EXPLORER_URL=https://polygonscan.com

# Endereços impressos por `npm run deploy:*`
VITE_TOKEN_ADDRESS=
VITE_NFT_ADDRESS=
VITE_FARM_ADDRESS=
VITE_STAKING_ADDRESS=

# Firebase (opcional: sobrescreve a configuração padrão em src/services/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
