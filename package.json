{
  "name": "dapp-nft-farm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.cjs --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.cjs --network polygon",
    "withdraw-bot": "hardhat run scripts/auto-withdraw.cjs --network polygon",
    "keeper": "hardhat run scripts/hatch-keeper.cjs --network polygon",
    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.22.17",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
